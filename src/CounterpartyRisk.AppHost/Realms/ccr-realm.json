{
  "realm": "ccr",
  "displayName": "Counterparty Risk Dashboard",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "userManagedAccessAllowed": false,
  "organizationsEnabled": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(15) and maxLength(128) and notUsername and notEmail and passwordHistory(5) and passwordBlacklist(ccr-deny-list.txt)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "defaultSignatureAlgorithm": "PS256",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "offlineSessionIdleTimeout": 0,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "attributes": {
    "frontendUrl": "",
    "acr.loa.map": "{\"pwd\":\"1\",\"mfa\":\"2\"}"
  },
  "roles": {
    "realm": [
      { "name": "ccr-risk-manager", "description": "Risk manager: exposures, capital, oversight, exports, method versions" },
      { "name": "ccr-front-office", "description": "Front office: exposures of its own scope, no capital, no export" },
      { "name": "ccr-direction", "description": "Direction: global view, approvals (limits, method versions, history corrections)" },
      { "name": "ccr-finance", "description": "Finance: regulatory reconciliation of its legal entities" },
      { "name": "ccr-limit-admin", "description": "Limit administration: limit register and thresholds only" },
      { "name": "ccr-auditor", "description": "Audit: audit trail and aggregated data quality view, no business data" }
    ]
  },
  "defaultRole": {
    "name": "default-roles-ccr",
    "description": "No default capability: every role is assigned explicitly",
    "composite": false,
    "clientRole": false
  },
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": true, "priority": 10, "config": {} },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 20, "config": {} },
    { "alias": "TERMS_AND_CONDITIONS", "name": "Terms and Conditions", "providerId": "TERMS_AND_CONDITIONS", "enabled": false, "defaultAction": false, "priority": 30, "config": {} },
    { "alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": false, "defaultAction": false, "priority": 40, "config": {} },
    { "alias": "delete_account", "name": "Delete Account", "providerId": "delete_account", "enabled": false, "defaultAction": false, "priority": 50, "config": {} }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "Subject and authentication time",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "acr",
      "description": "Authentication context class (MFA level, SEC-083)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "acr loa level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": { "id.token.claim": "true", "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Display name only (no e-mail, no technical attribute)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": { "id.token.claim": "true", "access.token.claim": "false", "userinfo.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "ccr-api",
      "description": "Audience ccr-api, realm roles and data scope, in the access token only",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience ccr-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ccr-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "legal entities",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ccr_legal_entities",
            "claim.name": "ccr_legal_entities",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "business lines",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ccr_business_lines",
            "claim.name": "ccr_business_lines",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "ccr-bff",
      "roles": ["ccr-risk-manager", "ccr-front-office", "ccr-direction", "ccr-finance", "ccr-limit-admin", "ccr-auditor"]
    }
  ],
  "defaultDefaultClientScopes": ["basic", "acr", "profile"],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "ccr-bff",
      "name": "Counterparty Risk BFF",
      "description": "Confidential client of the BFF: code flow + PKCE S256 only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CCR_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "alwaysDisplayInConsole": false,
      "rootUrl": "${CCR_BFF_BASE_URL}",
      "baseUrl": "/",
      "redirectUris": ["${CCR_BFF_BASE_URL}/signin-oidc"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CCR_BFF_BASE_URL}/signout-callback-oidc",
        "backchannel.logout.url": "${CCR_BFF_BACKCHANNEL_LOGOUT_URL}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true",
        "access.token.signed.response.alg": "PS256",
        "id.token.signed.response.alg": "PS256",
        "authorization.signed.response.alg": "PS256",
        "user.info.response.signature.alg": "PS256",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "require.pushed.authorization.requests": "false",
        "exclude.session.state.from.auth.response": "false",
        "token.response.type.bearer.lower-case": "false"
      },
      "defaultClientScopes": ["basic", "acr", "profile", "ccr-api"],
      "optionalClientScopes": []
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-ps256-3072",
        "providerId": "rsa-generated",
        "subComponents": {},
        "config": {
          "keySize": ["3072"],
          "algorithm": ["PS256"],
          "priority": ["100"],
          "active": ["true"],
          "enabled": ["true"]
        }
      },
      {
        "name": "hmac-hs512",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": {
          "algorithm": ["HS512"],
          "secretSize": ["64"],
          "priority": ["100"],
          "active": ["true"],
          "enabled": ["true"]
        }
      },
      {
        "name": "aes-256",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": {
          "secretSize": ["32"],
          "priority": ["100"],
          "active": ["true"],
          "enabled": ["true"]
        }
      }
    ],
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "subComponents": {},
        "config": {
          "host-sending-registration-request-must-match": ["true"],
          "client-uris-must-match": ["true"]
        }
      },
      {
        "name": "Max Clients Limit",
        "providerId": "max-clients",
        "subType": "anonymous",
        "subComponents": {},
        "config": { "max-clients": ["0"] }
      }
    ],
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":null,\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":64},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"ccr_legal_entities\",\"displayName\":\"Legal entities (LEI or *)\",\"validations\":{\"pattern\":{\"pattern\":\"^([A-Z0-9]{18}[0-9]{2}|\\\\*)$\",\"error-message\":\"invalid LEI\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":true},{\"name\":\"ccr_business_lines\",\"displayName\":\"Business lines (code or *)\",\"validations\":{\"pattern\":{\"pattern\":\"^([A-Z][A-Z0-9_-]{1,31}|\\\\*)$\",\"error-message\":\"invalid business line\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":true}],\"groups\":[]}"
          ]
        }
      }
    ]
  }
}
