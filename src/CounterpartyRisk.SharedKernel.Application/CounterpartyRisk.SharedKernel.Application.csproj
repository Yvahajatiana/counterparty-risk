<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CounterpartyRisk.SharedKernel.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CounterpartyRisk.SharedKernel.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Brings the LoggerMessage generator that honours [PersonalData]/[SensitiveData]; the default one
         logs them in clear text. PrivateAssets=none flows the analyzer to every project referencing this one. -->
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CounterpartyRisk.SharedKernel\CounterpartyRisk.SharedKernel.csproj" />
    <!-- Result and Error live in the BCL-only shared contracts (#5) -->
    <ProjectReference Include="..\CounterpartyRisk.Domain.Contracts\CounterpartyRisk.Domain.Contracts.csproj" />
  </ItemGroup>

</Project>
