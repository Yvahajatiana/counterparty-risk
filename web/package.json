{
  "name": "counterparty-risk-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css}\" \"scripts/**/*.mjs\" eslint.config.js",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "serve:csp": "node scripts/serve-csp.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource-variable/inter": "5.3.0",
    "ag-grid-angular": "36.3.0",
    "ag-grid-community": "36.3.0",
    "highcharts": "13.1.1",
    "highcharts-angular": "5.4.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/angular": "19.6.0",
    "@testing-library/dom": "10.4.2",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  }
}
